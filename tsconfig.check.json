{
  "compilerOptions": {
    "strict": true,
    "module": "nodenext",
    "target": "es2022",
    "lib": ["es2022"],
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["credentials/**/*.ts", "nodes/**/*.ts"],
  "exclude": ["node_modules", "dist", "__tests__"]
}
